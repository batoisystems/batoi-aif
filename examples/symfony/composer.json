{
  "name": "batoi/aif-symfony-adapter",
  "description": "Optional Symfony integration adapter for Batoi AIF",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.3",
    "batoi/aif": "dev-main",
    "symfony/http-foundation": "^7.1",
    "symfony/routing": "^7.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../..",
      "options": {"symlink": true}
    }
  ],
  "autoload": {
    "psr-4": {"Batoi\\Aif\\Symfony\\": "./"},
    "exclude-from-classmap": ["tests/"]
  },
  "autoload-dev": {
    "psr-4": {"Batoi\\Aif\\Symfony\\Tests\\": "tests/"}
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {"test": "phpunit"}
}
