{
  "name": "batoi/aif",
  "description": "Standalone PHP framework for governed AI execution and application integration",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "ext-curl": "*",
    "php": ">=8.3"
  },
  "suggest": {
    "ext-pdo_mysql": "Required only for MySQL-backed persistence adapters such as the Batoi RAD persistence profile.",
    "illuminate/support": "Useful for Laravel service provider integration examples and future Laravel adapter packages.",
    "symfony/framework-bundle": "Useful for Symfony bundle/controller integration examples and future Symfony adapter packages."
  },
  "autoload": {
    "psr-4": {
      "Batoi\\Aif\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Batoi\\Aif\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/aif-doctor.php",
    "bin/aif-config-check.php",
    "bin/aif-smoke.php",
    "bin/aif-rad-schema-check.php"
  ],
  "scripts": {
    "analyse": "phpstan analyse --no-progress --debug",
    "lint": "phpcs",
    "test": [
      "@test:unit",
      "@test:smoke"
    ],
    "test:smoke": "php tests/smoke.php",
    "test:unit": "phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "archive": {
    "name": "batoi-aif",
    "exclude": [
      "/.DS_Store",
      "/.github",
      "/.phpunit.cache",
      "/AGENTS.md",
      "/examples",
      "/specs",
      "/tests",
      "/vendor",
      "/composer.lock",
      "/phpcs.xml",
      "/phpstan.neon",
      "/phpunit.xml"
    ]
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^3.13"
  }
}
